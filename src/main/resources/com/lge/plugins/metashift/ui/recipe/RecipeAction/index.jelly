<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler"
xmlns:l="/lib/layout" xmlns:ms="/metashift" xmlns:dt="/data-tables">
  <l:layout title="meta-shift report">
    <st:include it="${it.run}" page="sidepanel.jelly" />
    <l:main-panel>
      <st:adjunct includes="io.jenkins.plugins.bootstrap5"/>
      <script src="${rootURL}/plugin/echarts-api/js/echarts.min.js"
              type="text/javascript"></script>
      <st:adjunct includes="com.lge.plugins.metashift.ui.metashift"/>

      <div class="small mb-2">
        <a href="..">&#8592; meta-shift report</a>
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
        <h1 class="h3 mb-0">${it.displayName}</h1>
        <j:if test="${!it.version.isEmpty()}">
          <span class="badge text-bg-secondary">${it.version}</span>
        </j:if>
      </div>
      <div class="d-flex flex-wrap gap-2 mb-3">
        <j:forEach var="card" items="${it.metricCards}">
          <span class="badge bg-${card.barClass}">${card.name}: ${card.statusText}</span>
        </j:forEach>
        <j:if test="${it.hasHtmlReport('test')}">
          <a class="badge text-bg-light border" target="_blank"
             href="${it.getHtmlReportUrl('test')}">test report &#8599;</a>
        </j:if>
        <j:if test="${it.hasHtmlReport('coverage')}">
          <a class="badge text-bg-light border" target="_blank"
             href="${it.getHtmlReportUrl('coverage')}">coverage report &#8599;</a>
        </j:if>
        <j:if test="${it.hasHtmlReport('checktest')}">
          <a class="badge text-bg-light border" target="_blank"
             href="${it.getHtmlReportUrl('checktest')}">mutation report &#8599;</a>
        </j:if>
      </div>

      <j:set var="testCount" value="${it.testCount}"/>
      <j:set var="fileCount" value="${it.fileCount}"/>
      <j:set var="mutationCount" value="${it.mutationCount}"/>

      <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" data-bs-toggle="tab"
                  data-bs-target="#ms-panel-overview" type="button" role="tab">
            Overview
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" data-bs-toggle="tab"
                  data-bs-target="#ms-panel-tests" type="button" role="tab">
            Tests <span class="badge text-bg-secondary ms-1">${testCount}</span>
            <j:if test="${it.failedTestCount &gt; 0}">
              <span class="badge text-bg-danger ms-1">${it.failedTestCount} failed</span>
            </j:if>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" data-bs-toggle="tab"
                  data-bs-target="#ms-panel-files" type="button" role="tab">
            Files <span class="badge text-bg-secondary ms-1">${fileCount}</span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" data-bs-toggle="tab"
                  data-bs-target="#ms-panel-mutations" type="button" role="tab">
            Mutations <span class="badge text-bg-secondary ms-1">${mutationCount}</span>
          </button>
        </li>
      </ul>

      <div class="tab-content">
        <div class="tab-pane fade show active" id="ms-panel-overview" role="tabpanel">
          <div class="mb-4">
            <ms:dynamic-testing-row/>
          </div>
          <div class="d-flex flex-wrap gap-4 mt-4">
            <div style="flex:1;min-width:320px;">
              <h2 class="h6">Unit Test Status</h2>
              <!-- MetricView.cardsFor() order: 0=Unit Tests, 3=Mutation Tests -->
              <div data-ms-donut="true"
                   data-dist="${it.metricCards.get(0).distributionJson}"
                   style="width:100%;height:320px;"></div>
            </div>
            <div style="flex:1;min-width:320px;">
              <h2 class="h6">Mutation Status</h2>
              <div data-ms-donut="true"
                   data-dist="${it.metricCards.get(3).distributionJson}"
                   style="width:100%;height:320px;"></div>
            </div>
          </div>
        </div>

        <div class="tab-pane fade" id="ms-panel-tests" role="tabpanel">
          <j:choose>
            <j:when test="${testCount &gt; 0}">
              <dt:table model="${it.getTableModel('unit_tests')}" />
            </j:when>
            <j:otherwise><div class="text-muted">N/A</div></j:otherwise>
          </j:choose>
        </div>

        <div class="tab-pane fade" id="ms-panel-files" role="tabpanel">
          <j:choose>
            <j:when test="${fileCount &gt; 0}">
              <dt:table model="${it.getTableModel('files')}" />
            </j:when>
            <j:otherwise><div class="text-muted">N/A</div></j:otherwise>
          </j:choose>
        </div>

        <div class="tab-pane fade" id="ms-panel-mutations" role="tabpanel">
          <j:choose>
            <j:when test="${mutationCount &gt; 0}">
              <dt:table model="${it.getTableModel('mutations')}" />
            </j:when>
            <j:otherwise><div class="text-muted">N/A</div></j:otherwise>
          </j:choose>
        </div>
      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
