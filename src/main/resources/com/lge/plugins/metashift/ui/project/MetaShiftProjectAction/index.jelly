<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout"
xmlns:ms="/metashift">
  <l:layout title="meta-shift report">
    <st:include it="${it.project}" page="sidepanel.jelly"/>
    <l:main-panel>
      <st:adjunct includes="io.jenkins.plugins.bootstrap5"/>

      <h1 class="h4">meta-shift report</h1>

      <j:choose>
        <j:when test="${it.lastResultBuildNumber == null}">
          <p class="text-muted">No build of this job has produced a meta-shift report so far.
            This page will show the latest report once one is available.</p>
          <ul>
            <li>Check that the <b>meta-shift report</b> post-build action is configured with a
              valid report root path.</li>
            <li>Run a build. Reports are not published for builds that finished as FAILURE.</li>
          </ul>
        </j:when>
        <j:otherwise>
          <h2 class="h6 mt-4">Current status
            <span class="text-muted small fw-normal">
              &#8212; <a href="../${it.lastResultBuildNumber}/meta-shift-report">latest
              report</a>
            </span>
          </h2>
          <ms:metric-cards cards="${it.latestCards}"/>

          <!-- History on the left, trend on the right: the two read the same builds, so putting
               them side by side lets one be checked against the other without scrolling, and
               keeps neither stretched across the full page. They stack below lg. -->
          <div class="row g-4 mt-1">
            <div class="col-lg-6">
              <h2 class="h6">Recent builds</h2>
              <div class="table-responsive">
                <table class="table table-sm align-middle">
                  <thead>
                    <tr>
                      <th>Build</th>
                      <th>Result</th>
                      <th>When</th>
                      <th class="text-end">Tests</th>
                      <th class="text-end">Stmt</th>
                      <th class="text-end">Branch</th>
                      <th class="text-end">Mutation</th>
                    </tr>
                  </thead>
                  <tbody>
                    <j:forEach var="row" items="${it.recentBuilds}">
                      <tr>
                        <td><a href="../${row.number}/meta-shift-report">${row.displayName}</a></td>
                        <td>
                          <span class="badge bg-${row.resultClass}">${row.result}</span>
                        </td>
                        <td class="text-muted small text-nowrap">${row.timestamp}</td>
                        <j:forEach var="card" items="${row.cards}">
                          <td class="text-end">
                            <span class="badge bg-${card.barClass}">${card.ratioText}</span>
                          </td>
                        </j:forEach>
                      </tr>
                    </j:forEach>
                  </tbody>
                </table>
              </div>
            </div>
            <div class="col-lg-6">
              <h2 class="h6">Trend</h2>
              <!-- Click-through is deliberately off: every build in the table beside it already
                   links to its own report, so a second navigation path would be redundant. -->
              <ms:trend-chart action="${it}"/>
            </div>
          </div>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
